# ============================================
# AllSports Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# This file contains both frontend (VITE_*) and backend variables

# ============================================
# SERVER CONFIGURATION (Backend)
# ============================================
PORT=3001
NODE_ENV=production

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Backend API URL
# For production: https://api.sedx3d.com
# For development: http://localhost:3001
VITE_API_BASE_URL=https://api.sedx3d.com

# Stripe Price IDs (Frontend)
# Get these from your Stripe Dashboard: https://dashboard.stripe.com
VITE_STRIPE_PRICE_BASIC=price_xxxxxxxxxxxxx
VITE_STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
VITE_STRIPE_PRICE_PREMIUM=price_xxxxxxxxxxxxx

# Stripe Publishable Key (optional, for future features)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# ============================================
# BACKEND CONFIGURATION
# ============================================
# Frontend URL (for CORS and redirects after Stripe checkout)
# For production: https://allsports.sedx3d.com
# For development: http://localhost:5173
FRONTEND_URL=https://allsports.sedx3d.com

# Allowed Origins for CORS (comma-separated, or use '*' for all)
# If not set, defaults to FRONTEND_URL and common localhost ports
# For production: https://allsports.sedx3d.com
# For development: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://allsports.sedx3d.com

# ============================================
# STRIPE CONFIGURATION (Backend)
# ============================================
# Get these from your Stripe Dashboard: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ============================================
# GOOGLE GEMINI API
# ============================================
# Get this from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Your Firebase service account private key should be in backend/private-key.json
# Storage bucket will be auto-detected from private-key.json, or set manually:
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
