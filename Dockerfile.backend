# Backend Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY backend/package*.json ./

# Install dependencies
# npm install works with or without package-lock.json
RUN npm install --only=production

# Copy backend source code
COPY backend/ ./

# Expose port 5001
EXPOSE 5001

# Set default environment variable for port
ENV PORT=5001

# Start the application
CMD ["node", "index.js"]

